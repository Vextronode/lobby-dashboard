# Template Konfigurasi Environment Produksi - Lobby Dashboard Desa Cibenda
# Salin berkas ini ke `.env` di folder root atau deploy sebelum menjalankan `docker compose up -d`

# 1. URL Upstream Layanan Desa Cibenda (Wajib)
SIGAP_BASE_URL=https://sigap.cibenda.desa.id/api
SID_BASE_URL=https://sid.cibenda.desa.id/api
CIMART_BASE_URL=https://cimart.cibenda.desa.id/api

# 2. Notifikasi Gangguan Telegram (Opsional - F14)
# Dapatkan token bot dari @BotFather dan chat ID dari @userinfobot atau getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_TECH=
TELEGRAM_CHAT_ADMIN=

# 3. Pengaturan Server & Kiosk
PORT=8080
TRUST_PROXY=false
BUILD_ID=v1.0.0
