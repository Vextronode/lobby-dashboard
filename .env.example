# Copy to .env and fill in. Never commit real URLs or tokens.

# Upstream base URLs (HTTPS in production). Paths such as /api/public/... are appended by the aggregator.
SIGAP_BASE_URL=https://sigap.example.id
SID_BASE_URL=https://sid.example.id
CIMART_BASE_URL=https://cimart.example.id

# Telegram notifications (F14). Leave empty to disable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_TECH=
TELEGRAM_CHAT_ADMIN=

# Snapshot and thumbnail directory (a Docker volume in production).
DATA_DIR=/data

# Path to the validated config file.
LOBBY_CONFIG_PATH=config/lobby.config.json

PORT=8080

# Version shown as `build` in API responses; set by the deploy (LOBBY-05).
BUILD_ID=

# Built web client served by the aggregator (production image). Leave empty in dev (Vite serves it).
WEB_DIST_DIR=

# true when running behind a reverse proxy that sets X-Forwarded-For (rate limiting per client IP).
TRUST_PROXY=false
